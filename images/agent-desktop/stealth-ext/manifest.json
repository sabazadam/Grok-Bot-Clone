{
  "manifest_version": 3,
  "name": "GrokBot Stealth",
  "version": "1.0.0",
  "description": "Reduces automation/VM fingerprints for agent browsing.",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ]
}
