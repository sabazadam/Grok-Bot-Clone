# ── Model provider API keys (set the ones you have; each agent picks its provider) ──
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
# xAI / any OpenAI-compatible endpoint (used by the "generic" provider)
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1

# ── Server ──
PORT=8484
HOST=127.0.0.1
DATA_DIR=./data

# ── Agent computers (Docker) ──
# Max agent containers running at once (each uses ~1-2GB RAM)
MAX_RUNNING_COMPUTERS=4
# Stop idle agent computers after N minutes (0 = never). State survives in its volume.
COMPUTER_IDLE_STOP_MINUTES=30
# Desktop resolution inside each agent OS
COMPUTER_RESOLUTION=1280x800
# Memory limit per agent container
COMPUTER_MEMORY=2g
# Docker socket (default works for Docker Desktop / OrbStack / Linux)
DOCKER_SOCKET=/var/run/docker.sock
